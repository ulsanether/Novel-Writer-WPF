<Window
    x:Class="NovelWriter.Wpf.ReferenceGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="참고자료 생성기"
    Width="560"
    Height="640"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontSize="16" FontWeight="Bold" Text="참고자료 생성기 (.md)" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Margin="0,0,6,0"
                materialDesign:HintAssist.Hint="유형"
                ItemsSource="{Binding DocTypes}"
                SelectedItem="{Binding DocType}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            <TextBox
                Grid.Column="1"
                Margin="6,0,0,0"
                materialDesign:HintAssist.Hint="제목(파일명)"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding Title}" />
        </Grid>

        <TextBox
            DockPanel.Dock="Top"
            Height="80"
            Margin="0,0,0,8"
            materialDesign:HintAssist.Hint="요청 내용 (예: 20대 형사 김철수, 냉소적 성격, 과거의 트라우마)"
            AcceptsReturn="True"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button
                DockPanel.Dock="Left"
                Command="{Binding GenerateCommand}"
                Content="AI 생성"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <ProgressBar
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding StatusMessage}" />
            <Button
                HorizontalAlignment="Right"
                Command="{Binding SaveCommand}"
                Content=".md로 저장"
                DockPanel.Dock="Right"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </DockPanel>

        <TextBox
            materialDesign:HintAssist.Hint="생성 결과 (수정 가능)"
            AcceptsReturn="True"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            Text="{Binding GeneratedContent, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
