<Window
    x:Class="NovelWriter.Wpf.ReferenceGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="참고자료 생성기"
    Width="620"
    Height="780"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:PathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock
            Margin="0,0,0,10"
            DockPanel.Dock="Top"
            FontSize="16"
            FontWeight="Bold"
            Text="참고자료 생성기 (.md)" />

        <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Margin="0,0,6,0"
                materialDesign:HintAssist.Hint="유형"
                ItemsSource="{Binding DocTypes}"
                SelectedItem="{Binding DocType}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            <TextBox
                Grid.Column="1"
                Margin="6,0,0,0"
                materialDesign:HintAssist.Hint="제목(파일명)"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding Title}" />
        </Grid>

        <TextBox
            Height="80"
            Margin="0,0,0,8"
            materialDesign:HintAssist.Hint="요청 내용 (예: 20대 형사 김철수, 냉소적 성격, 과거의 트라우마)"
            AcceptsReturn="True"
            DockPanel.Dock="Top"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <Button
                Margin="0,0,8,0"
                Command="{Binding AutoFillCommand}"
                Content="🎲 랜덤, 자동 생성"
                DockPanel.Dock="Left"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="선택한 유형에 맞는 제목과 요청 내용을 무작위로 지어냅니다." />
            <Button
                Command="{Binding GenerateCommand}"
                Content="AI 생성"
                DockPanel.Dock="Left"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <ProgressBar
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.8"
                Text="{Binding StatusMessage}" />
            <Button
                HorizontalAlignment="Right"
                Command="{Binding SaveCommand}"
                Content=".md로 저장"
                DockPanel.Dock="Right"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </DockPanel>

        <!--  이미지 생성 (캐릭터/배경 삽화)  -->
        <Border
            Margin="0,8,0,0"
            Padding="10"
            Background="#18808080"
            CornerRadius="6"
            DockPanel.Dock="Bottom">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="🖼 이미지 생성 (생성된 설정 기반)" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="11"
                    Opacity="0.8"
                    Text="{Binding ImageServerStatus}" />
                <TextBox
                    Margin="0,0,0,6"
                    materialDesign:HintAssist.Hint="이미지 프롬프트(영어, 비우면 내용에서 자동 생성)"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding ImagePrompt}"
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Command="{Binding GenerateImageCommand}"
                        Content="이미지 생성"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button
                        Command="{Binding InsertImageCommand}"
                        Content="본문에 삽입"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="생성된 이미지를 원고 본문에 삽입합니다." />
                </StackPanel>
                <Image
                    MaxHeight="200"
                    HorizontalAlignment="Left"
                    Source="{Binding GeneratedImagePath, Converter={StaticResource PathToImage}}"
                    Stretch="Uniform" />
            </StackPanel>
        </Border>

        <TextBox
            materialDesign:HintAssist.Hint="생성 결과 (수정 가능)"
            AcceptsReturn="True"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            Text="{Binding GeneratedContent, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
