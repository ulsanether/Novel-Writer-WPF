<Window
    x:Class="NovelWriter.Wpf.SettingsHubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="설정"
    Width="660"
    Height="820"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:StringToBrushConverter x:Key="StringToBrush" />
        <local:NovelModelBadgeConverter x:Key="NovelBadge" />
        <local:UncensoredModelBadgeConverter x:Key="UncensoredBadge" />
        <local:KoreanModelBadgeConverter x:Key="KoreanBadge" />
        <local:InstalledModelBadgeConverter x:Key="InstalledBadge" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!--  하단 공통 저장/닫기  -->
        <Border
            Padding="24,12"
            Background="#22808080"
            DockPanel.Dock="Bottom">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnSave"
                    Content="저장"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    Width="90"
                    Click="OnClose"
                    Content="닫기"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Border>

        <TabControl
            x:Name="Tabs"
            Margin="8"
            materialDesign:ColorZoneAssist.Mode="PrimaryLight">
            <!--  ===== 탭: 일반 =====  -->
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Margin="0,0,0,4" Text="{Binding AiModelLabelText}" />
                        <ComboBox
                            Margin="0,0,0,20"
                            IsEditable="True"
                            ItemsSource="{Binding AvailableModels}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding AiModel, UpdateSourceTrigger=LostFocus}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal">
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="#FF2E7D32"
                                                CornerRadius="8">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource InstalledBadge}">
                                                        <Binding />
                                                        <Binding Path="DataContext.InstalledModels" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="설치됨" />
                                            </Border>
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="#FF1565C0"
                                                CornerRadius="8"
                                                Visibility="{Binding Converter={StaticResource KoreanBadge}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="한글 특화" />
                                            </Border>
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource PrimaryHueMidBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding Converter={StaticResource NovelBadge}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                                    Text="노벨 특화" />
                                            </Border>
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="#FFD84315"
                                                CornerRadius="8"
                                                Visibility="{Binding Converter={StaticResource UncensoredBadge}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="무검열 노벨 특화" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  무검열 모델 경고  -->
                        <Border
                            Margin="0,0,0,20"
                            Padding="10,8"
                            Background="#33D84315"
                            CornerRadius="6"
                            Visibility="{Binding IsAiModelUncensored, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    Text="🔞" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#FFFF8A65"
                                    Text="무검열(검열 해제) 모델입니다. 성인·폭력·불법 등 제한 없는 내용을 생성할 수 있으니, 관련 법규를 지켜 성인 본인만 개인 용도로 사용하세요. 생성 결과의 책임은 사용자에게 있습니다."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <CheckBox
                            Margin="0,0,0,12"
                            Content="{Binding AutoSaveLabelText}"
                            IsChecked="{Binding AutoSaveEnabled}" />
                        <TextBlock Margin="0,0,0,4" Text="{Binding AutoSaveIntervalLabelText}" />
                        <TextBox
                            Margin="0,0,0,20"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding AutoSaveSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===== 탭: 테마·외형 =====  -->
            <TabItem Header="테마·외형">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!--  폰트 크기들  -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding MenuFontSizeLabelText}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding MenuFontSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,20"
                            IsSnapToTickEnabled="True"
                            Maximum="24"
                            Minimum="10"
                            TickFrequency="1"
                            Value="{Binding MenuFontSize}" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding EditorFontSizeLabelText}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding EditorFontSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,20"
                            IsSnapToTickEnabled="True"
                            Maximum="48"
                            Minimum="12"
                            TickFrequency="1"
                            Value="{Binding EditorFontSize}" />

                        <TextBlock Margin="0,0,0,4" Text="편집기 폰트 종류" />
                        <ComboBox
                            Margin="0,0,0,20"
                            IsEditable="True"
                            ItemsSource="{Binding FontFamilies}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding EditorFontFamilyName, UpdateSourceTrigger=LostFocus}" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ToolbarIconSizeLabelText}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding ToolbarIconSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,20"
                            IsSnapToTickEnabled="True"
                            Maximum="48"
                            Minimum="18"
                            TickFrequency="1"
                            Value="{Binding ToolbarIconSize}" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ReferenceFontSizeLabelText}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding ReferenceFontSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,20"
                            IsSnapToTickEnabled="True"
                            Maximum="28"
                            Minimum="10"
                            TickFrequency="1"
                            Value="{Binding ReferenceFontSize}" />

                        <TextBlock Margin="0,0,0,4" Text="{Binding ReferenceColorLabelText}" />
                        <DockPanel Margin="0,0,0,6">
                            <Border
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="{Binding ReferenceForeground}"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                DockPanel.Dock="Right" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ReferenceForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ItemsControl Margin="0,0,0,20" ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="2"
                                        Background="{Binding Converter={StaticResource StringToBrush}}"
                                        BorderBrush="#40000000"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SetReferenceColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ChatFontSizeLabelText}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding ChatFontSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,20"
                            IsSnapToTickEnabled="True"
                            Maximum="24"
                            Minimum="10"
                            TickFrequency="1"
                            Value="{Binding ChatFontSize}" />

                        <TextBlock Margin="0,0,0,4" Text="{Binding ChatBackgroundLabelText}" />
                        <DockPanel Margin="0,0,0,6">
                            <Border
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="{Binding ChatBackground}"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                DockPanel.Dock="Right" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ChatBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="2"
                                        Background="{Binding Converter={StaticResource StringToBrush}}"
                                        BorderBrush="#40000000"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SetChatBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8,0,12" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="Bold"
                            Text="{Binding CustomThemeLabelText}" />

                        <TextBlock Margin="0,0,0,4" Text="{Binding CustomBackgroundLabelText}" />
                        <DockPanel Margin="0,0,0,6">
                            <Border
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="{Binding CustomBackgroundHex, Converter={StaticResource StringToBrush}}"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                DockPanel.Dock="Right" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CustomBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="2"
                                        Background="{Binding Converter={StaticResource StringToBrush}}"
                                        BorderBrush="#40000000"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SetCustomBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,0,0,4" Text="{Binding CustomForegroundLabelText}" />
                        <DockPanel Margin="0,0,0,6">
                            <Border
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="{Binding CustomForegroundHex, Converter={StaticResource StringToBrush}}"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                DockPanel.Dock="Right" />
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CustomForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="2"
                                        Background="{Binding Converter={StaticResource StringToBrush}}"
                                        BorderBrush="#40000000"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SetCustomForegroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,4,0,4" Text="배경 이미지" />
                        <DockPanel Margin="0,0,0,6">
                            <Button
                                Margin="6,0,0,0"
                                Command="{Binding ClearBackgroundImageCommand}"
                                Content="지우기"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button
                                Margin="6,0,0,0"
                                Command="{Binding OpenBackgroundImageCommand}"
                                Content="선택"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <TextBox
                                materialDesign:HintAssist.Hint="이미지 경로 (비우면 색 배경)"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding BackgroundImagePath}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="이미지 투명도" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding BackgroundOpacity, StringFormat=0.00}" />
                        </DockPanel>
                        <Slider
                            Margin="0,0,0,8"
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            Value="{Binding BackgroundOpacity}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===== 탭: 이미지 =====  -->
            <TabItem Header="이미지 서버 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="🖼️ 이미지 생성 서버 (ComfyUI)" />
                        <TextBlock
                            Margin="0,0,0,16"
                            Opacity="0.7"
                            Text="캐릭터·장면 삽화 생성용 서버입니다. 순서대로 설치 → 모델 다운로드 → 실행하세요."
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,0,0,14"
                            Padding="14"
                            Background="#18808080"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold"
                                    Text="내 그래픽카드 사양 (VRAM)" />
                                <ComboBox
                                    Margin="0,0,0,2"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding HardwareProfiles}"
                                    SelectedItem="{Binding SelectedHardware}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="{Binding SelectedHardware.Note}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding TestImageServerCommand}"
                                        Content="연결 확인"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding LaunchImageServerCommand}"
                                        Content="서버 실행"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ImageServerStatus}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,0,14"
                            Padding="14"
                            Background="#18808080"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontWeight="SemiBold"
                                    Text="ComfyUI — 최신 모델 (SDXL·FLUX)" />
                                <TextBox
                                    Margin="0,0,0,8"
                                    materialDesign:HintAssist.Hint="서버 주소 (예: http://127.0.0.1:8188)"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ComfyUiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Opacity="0.7"
                                    Text="포터블 빌드라 Python 설치가 필요 없습니다. [자동 설치]는 7-Zip(없으면 자동 설치) + 약 1.5~2GB를 내려받습니다. 설치 후 모델(.safetensors)을 모델 폴더에 넣어야 합니다."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding InstallComfyUiCommand}"
                                        Content="ComfyUI 자동 설치"
                                        IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding LaunchImageServerCommand}"
                                        Content="ComfyUI 실행"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button
                                        Command="{Binding OpenComfyModelsFolderCommand}"
                                        Content="모델 폴더 열기"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </StackPanel>
                                <TextBox
                                    Margin="0,8,0,0"
                                    materialDesign:HintAssist.Hint="설치 경로"
                                    IsReadOnly="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ComfyUiPath}" />

                                <Separator Margin="0,12,0,10" Opacity="0.3" />
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontWeight="SemiBold"
                                    Text="모델(체크포인트) 자동 다운로드" />
                                <ComboBox
                                    Margin="0,0,0,4"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding ComfyModels}"
                                    SelectedItem="{Binding SelectedComfyModel}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="{Binding SelectedComfyModel.Note}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="8,4"
                                    Background="#33D84315"
                                    CornerRadius="4"
                                    Visibility="{Binding SelectedComfyModel.Uncensored, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#FFFF8A65"
                                        Text="🔞 무검열 모델입니다. 로컬 생성이라 필터가 없으니, 관련 법규와 각 모델 라이선스를 지켜 성인 본인만 개인 용도로 사용하세요."
                                        TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DownloadComfyModelCommand}"
                                        Content="선택 모델 다운로드"
                                        IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{Binding EnsureComfyModelCommand}"
                                        Content="모델 자동 준비"
                                        IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="설치된 모델이 없으면 선택 모델을 자동으로 내려받아 연결합니다." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <ProgressBar
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                IsIndeterminate="True"
                                Style="{StaticResource MaterialDesignCircularProgressBar}"
                                Visibility="{Binding IsImageSetupBusy, Converter={StaticResource BoolToVis}}"
                                Value="0" />
                            <Button
                                Command="{Binding OpenImageServerPageCommand}"
                                Content="설치 안내 열기"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="진행 로그" />
                        <Border
                            Padding="8"
                            Background="#22000000"
                            CornerRadius="4">
                            <TextBox
                                Height="150"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="11"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{Binding ImageSetupLog}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
