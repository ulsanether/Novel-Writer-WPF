<Window
    x:Class="NovelWriter.Wpf.ThemeCustomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="테마 커스텀"
    Width="480"
    Height="720"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <local:StringToBrushConverter x:Key="StringToBrush" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12" Background="#22808080">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Click="OnSave" Content="{Binding SettingsSaveText}" Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Width="90" Click="OnClose" Content="{Binding SettingsCloseText}" Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <!-- 폰트 크기들 -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding MenuFontSizeLabelText}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding MenuFontSize, StringFormat=0}" />
                </DockPanel>
                <Slider Margin="0,0,0,20" Maximum="24" Minimum="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MenuFontSize}" />

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding EditorFontSizeLabelText}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding EditorFontSize, StringFormat=0}" />
                </DockPanel>
                <Slider Margin="0,0,0,20" Maximum="48" Minimum="12" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding EditorFontSize}" />

                <!-- 편집기 폰트 종류 -->
                <TextBlock Margin="0,0,0,4" Text="편집기 폰트 종류" />
                <ComboBox
                    Margin="0,0,0,20"
                    IsEditable="True"
                    ItemsSource="{Binding FontFamilies}"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    Text="{Binding EditorFontFamilyName, UpdateSourceTrigger=LostFocus}" />

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ToolbarIconSizeLabelText}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding ToolbarIconSize, StringFormat=0}" />
                </DockPanel>
                <Slider Margin="0,0,0,20" Maximum="48" Minimum="18" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ToolbarIconSize}" />

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ReferenceFontSizeLabelText}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding ReferenceFontSize, StringFormat=0}" />
                </DockPanel>
                <Slider Margin="0,0,0,20" Maximum="28" Minimum="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ReferenceFontSize}" />

                <!-- 참고자료 색 -->
                <TextBlock Margin="0,0,0,4" Text="{Binding ReferenceColorLabelText}" />
                <DockPanel Margin="0,0,0,6">
                    <Border Width="36" Height="36" Margin="0,0,10,0" DockPanel.Dock="Right" Background="{Binding ReferenceForeground}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" />
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ReferenceForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ItemsControl Margin="0,0,0,20" ItemsSource="{Binding PaletteColors}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2" Background="{Binding Converter={StaticResource StringToBrush}}" BorderBrush="#40000000" BorderThickness="1" Command="{Binding DataContext.SetReferenceColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 채팅 폰트/배경 -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ChatFontSizeLabelText}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding ChatFontSize, StringFormat=0}" />
                </DockPanel>
                <Slider Margin="0,0,0,20" Maximum="24" Minimum="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ChatFontSize}" />

                <TextBlock Margin="0,0,0,4" Text="{Binding ChatBackgroundLabelText}" />
                <DockPanel Margin="0,0,0,6">
                    <Border Width="36" Height="36" Margin="0,0,10,0" DockPanel.Dock="Right" Background="{Binding ChatBackground}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" />
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ChatBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding PaletteColors}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2" Background="{Binding Converter={StaticResource StringToBrush}}" BorderBrush="#40000000" BorderThickness="1" Command="{Binding DataContext.SetChatBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 테마 커스텀 색 -->
                <Separator Margin="0,8,0,12" />
                <TextBlock Margin="0,0,0,8" FontWeight="Bold" Text="{Binding CustomThemeLabelText}" />

                <TextBlock Margin="0,0,0,4" Text="{Binding CustomBackgroundLabelText}" />
                <DockPanel Margin="0,0,0,6">
                    <Border Width="36" Height="36" Margin="0,0,10,0" DockPanel.Dock="Right" Background="{Binding CustomBackgroundHex, Converter={StaticResource StringToBrush}}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" />
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CustomBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding PaletteColors}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2" Background="{Binding Converter={StaticResource StringToBrush}}" BorderBrush="#40000000" BorderThickness="1" Command="{Binding DataContext.SetCustomBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,0,0,4" Text="{Binding CustomForegroundLabelText}" />
                <DockPanel Margin="0,0,0,6">
                    <Border Width="36" Height="36" Margin="0,0,10,0" DockPanel.Dock="Right" Background="{Binding CustomForegroundHex, Converter={StaticResource StringToBrush}}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" />
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CustomForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding PaletteColors}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="2" Background="{Binding Converter={StaticResource StringToBrush}}" BorderBrush="#40000000" BorderThickness="1" Command="{Binding DataContext.SetCustomForegroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 배경 이미지 -->
                <TextBlock Margin="0,4,0,4" Text="배경 이미지" />
                <DockPanel Margin="0,0,0,6">
                    <Button Margin="6,0,0,0" Command="{Binding ClearBackgroundImageCommand}" Content="지우기" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Margin="6,0,0,0" Command="{Binding OpenBackgroundImageCommand}" Content="선택" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}" />
                    <TextBox materialDesign:HintAssist.Hint="이미지 경로 (비우면 색 배경)" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding BackgroundImagePath}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="이미지 투명도" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding BackgroundOpacity, StringFormat=0.00}" />
                </DockPanel>
                <Slider Margin="0,0,0,8" Maximum="1" Minimum="0" TickFrequency="0.05" Value="{Binding BackgroundOpacity}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
