<Window
    x:Class="NovelWriter.Wpf.ImageStyleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="화풍 설정 — 이미지 생성"
    Width="640"
    Height="800"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">
        <!-- 하단 버튼 -->
        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#22808080">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.8" Text="{Binding StyleResolutionPreview, StringFormat=해상도/스텝: {0}}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="110" Margin="0,0,8,0" Click="OnGenerate" Content="이미지 생성" Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Width="80" Click="OnCancel" Content="취소" Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Margin="0,0,0,4" FontSize="18" FontWeight="Bold" Text="🎨 화풍 설정" />
                <TextBlock Margin="0,0,0,14" Opacity="0.7" Text="프롬프트를 몰라도 됩니다. 아래에서 고르면 자동으로 이미지 프롬프트가 만들어집니다." TextWrapping="Wrap" />

                <!-- 프리셋 + 세부 화풍 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="화풍 프리셋" />
                        <ComboBox Margin="0,0,0,10" ItemsSource="{Binding StylePresetOptions}" SelectedItem="{Binding StylePreset}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource Cap}" Text="품질" />
                                <ComboBox ItemsSource="{Binding StyleQualityOptions}" SelectedItem="{Binding StyleQuality}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource Cap}" Text="콘텐츠 등급" />
                                <ComboBox ItemsSource="{Binding StyleContentRatingOptions}" SelectedItem="{Binding StyleContentRating}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 구도 / 카메라 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="구도 · 카메라" />
                        <TextBlock Style="{StaticResource Cap}" Text="카메라 각도" />
                        <ComboBox Margin="0,0,0,8" ItemsSource="{Binding StyleCameraAngleOptions}" SelectedItem="{Binding StyleCameraAngle}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <!-- 인물 전용 옵션: 인물 생성일 때만 표시 -->
                        <StackPanel Visibility="{Binding StyleIsPersonSubject, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Text="👤 인물 옵션" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource Cap}" Text="촬영 범위 (전신/상반신 등)" />
                                    <ComboBox ItemsSource="{Binding StyleShotOptions}" SelectedItem="{Binding StyleShot}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource Cap}" Text="인물 수" />
                                    <ComboBox ItemsSource="{Binding StyleCharacterCountOptions}" SelectedItem="{Binding StyleCharacterCount}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 조명 / 색감 / 분위기 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="조명 · 색감 · 분위기" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource Cap}" Text="조명" />
                                <ComboBox ItemsSource="{Binding StyleLightingOptions}" SelectedItem="{Binding StyleLighting}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource Cap}" Text="색감" />
                                <ComboBox ItemsSource="{Binding StyleColorMoodOptions}" SelectedItem="{Binding StyleColorMood}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource Cap}" Text="분위기" />
                                <ComboBox ItemsSource="{Binding StyleMoodOptions}" SelectedItem="{Binding StyleMood}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 환경 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="환경" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource Cap}" Text="배경" />
                                <ComboBox ItemsSource="{Binding StyleBackgroundOptions}" SelectedItem="{Binding StyleBackground}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource Cap}" Text="시간대" />
                                <ComboBox ItemsSource="{Binding StyleTimeOfDayOptions}" SelectedItem="{Binding StyleTimeOfDay}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 핵심 슬라이더 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="핵심 조절" />
                        <TextBlock Style="{StaticResource Cap}" Text="{Binding StyleRealism, StringFormat=현실감 (스타일화 ↔ 실사): {0}}" />
                        <Slider Margin="0,0,0,8" Maximum="100" Minimum="0" TickFrequency="1" Value="{Binding StyleRealism}" />
                        <TextBlock Style="{StaticResource Cap}" Text="{Binding StyleDetail, StringFormat=디테일 (단순 ↔ 정교): {0}}" />
                        <Slider Margin="0,0,0,8" Maximum="100" Minimum="0" TickFrequency="1" Value="{Binding StyleDetail}" />
                        <TextBlock Style="{StaticResource Cap}" Text="{Binding StyleBackgroundComplexity, StringFormat=배경 복잡도 (미니멀 ↔ 복잡): {0}}" />
                        <Slider Maximum="100" Minimum="0" TickFrequency="1" Value="{Binding StyleBackgroundComplexity}" />
                    </StackPanel>
                </Border>

                <!-- 추가/제외 프롬프트 + 미리보기 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="직접 입력 (선택)" />
                        <TextBox Margin="0,0,0,6" materialDesign:HintAssist.Hint="추가 프롬프트(＋, 영어)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding StyleExtraPositive, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,0,0,10" materialDesign:HintAssist.Hint="제외 프롬프트(－, 영어)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding StyleExtraNegative, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding StylePositivePreview, StringFormat=긍정: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Opacity="0.7" Text="{Binding StyleNegativePreview, StringFormat=부정: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
