<Window
    x:Class="NovelWriter.Wpf.StoryPlannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:NovelWriter.Wpf.Models"
    Title="스토리 플래너"
    Width="1180"
    Height="800"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:PathToImageConverter x:Key="PathToImage" />
        <local:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  좌: 작품 설정 + 시놉시스 — 세로 탭 2열 (시놉시스 생성은 탭 밖)  -->
        <DockPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,10,0">
            <Button
                Margin="0,0,0,8"
                Command="{Binding GenerateSynopsisCommand}"
                Content="전체 시놉시스 생성"
                DockPanel.Dock="Top"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <TabControl TabStripPlacement="Left">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <!--  탭 1: 기본  -->
                <TabItem Header="기본">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="15"
                                FontWeight="Bold"
                                Text="작품 설정 (Story Bible)" />
                            <TextBox
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="제목"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.Title}" />
                            <ComboBox
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="장르 (선택 또는 입력)"
                                IsEditable="True"
                                ItemsSource="{Binding GenreSamples}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding Project.Genre, UpdateSourceTrigger=LostFocus}" />
                            <ComboBox
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="시대 (선택 또는 입력)"
                                IsEditable="True"
                                ItemsSource="{Binding EraSamples}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding Project.Era, UpdateSourceTrigger=LostFocus}" />
                            <TextBox
                                Margin="0,0,0,12"
                                materialDesign:HintAssist.Hint="장 수"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.ChapterCount}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  탭 2: 배경·인물·시놉시스 (병합)  -->
                <TabItem Header="세부">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <ComboBox
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="세계관 (선택 또는 입력)"
                                IsEditable="True"
                                ItemsSource="{Binding WorldSamples}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding Project.World, UpdateSourceTrigger=LostFocus}" />
                            <TextBox
                                MinHeight="52"
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="핵심 사건"
                                AcceptsReturn="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.CoreEvent}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="결말 (선택 또는 입력)"
                                IsEditable="True"
                                ItemsSource="{Binding EndingSamples}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding Project.Ending, UpdateSourceTrigger=LostFocus}" />
                            <TextBox
                                MinHeight="52"
                                Margin="0,0,0,8"
                                materialDesign:HintAssist.Hint="금지사항 (예: 준호는 12장 이전에 비밀을 알면 안 됨)"
                                AcceptsReturn="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.Forbidden}"
                                TextWrapping="Wrap" />
                            <Separator Margin="0,10,0,10" />
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="Bold"
                                Text="등장인물" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock FontWeight="SemiBold" Text="인물 목록" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding AddCharacterCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    ToolTip="인물 추가">
                                    <materialDesign:PackIcon Kind="Plus" />
                                </Button>
                            </DockPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Opacity="0.8"
                                Text="{Binding ImageServerStatus}" />
                            <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Project.Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StoryCharacter}">
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="8"
                                            Background="#22808080"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button
                                                        Command="{Binding DataContext.RemoveCharacterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        ToolTip="삭제">
                                                        <materialDesign:PackIcon Kind="Delete" />
                                                    </Button>
                                                    <Button
                                                        Command="{Binding DataContext.ExportCharacterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        ToolTip="참고자료(.md)로 내보내기">
                                                        <materialDesign:PackIcon Kind="FileExportOutline" />
                                                    </Button>
                                                    <Button
                                                        Command="{Binding DataContext.GenerateCharacterImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        ToolTip="캐릭터 이미지 생성">
                                                        <materialDesign:PackIcon Kind="ImagePlusOutline" />
                                                    </Button>
                                                    <TextBox materialDesign:HintAssist.Hint="이름" Text="{Binding Name}" />
                                                </DockPanel>
                                                <TextBox
                                                    Margin="0,4,0,0"
                                                    materialDesign:HintAssist.Hint="성격"
                                                    Text="{Binding Personality}" />
                                                <TextBox
                                                    Margin="0,4,0,0"
                                                    materialDesign:HintAssist.Hint="목표"
                                                    Text="{Binding Goal}" />
                                                <TextBox
                                                    Margin="0,4,0,0"
                                                    materialDesign:HintAssist.Hint="비밀"
                                                    Text="{Binding Secret}" />
                                                <TextBox
                                                    Margin="0,4,0,0"
                                                    materialDesign:HintAssist.Hint="관계"
                                                    Text="{Binding Relationships}" />
                                                <Image
                                                    MaxHeight="140"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Left"
                                                    Source="{Binding ReferenceImagePath, Converter={StaticResource PathToImage}}"
                                                    Stretch="Uniform" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="8,2"
                                                        Command="{Binding DataContext.InsertCharacterImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="본문에 삽입"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                    <Button
                                                        Padding="8,2"
                                                        Command="{Binding DataContext.SaveCharacterImageAsFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="파일로 저장"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,10,0,10" />
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="Bold"
                                Text="전체 시놉시스" />
                            <TextBox
                                MinHeight="200"
                                MaxHeight="360"
                                materialDesign:HintAssist.Hint="시놉시스"
                                AcceptsReturn="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.Synopsis}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  탭 3: 참고자료  -->
                <TabItem Header="참고자료">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!--  참고자료 연동 (참고자료 폴더 → 인물/생성 참조)  -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock FontWeight="Bold" Text="📎 참고자료 연동" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding LoadReferencesCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    ToolTip="새로고침">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                            </DockPanel>
                            <ListBox
                                MaxHeight="120"
                                Margin="0,0,0,6"
                                ItemsSource="{Binding References}"
                                SelectedItem="{Binding SelectedReference}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="FileDocumentOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button
                                    Margin="0,0,6,6"
                                    Command="{Binding ImportCharacterCommand}"
                                    Content="인물로 추가"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                                <Button
                                    Margin="0,0,6,6"
                                    Command="{Binding IncludeReferenceCommand}"
                                    Content="설정에 참조"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button
                                    Margin="0,0,0,6"
                                    Command="{Binding ClearReferenceNotesCommand}"
                                    Content="참조 비우기"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                            </WrapPanel>
                            <TextBox
                                MaxHeight="80"
                                materialDesign:HintAssist.Hint="생성 참조 메모 (인물·배경 묘사 등, 생성 시 반영)"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Project.ReferenceNotes}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!--  중: 트리 + 편집 버튼  -->
        <DockPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,10,0">
            <TextBlock
                Margin="0,0,0,6"
                DockPanel.Dock="Top"
                FontWeight="Bold"
                Text="구조" />
            <Button
                Margin="0,0,0,8"
                Command="{Binding GenerateChaptersCommand}"
                Content="장 구성 생성 (AI)"
                DockPanel.Dock="Top"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                <Button
                    Margin="0,0,6,6"
                    Command="{Binding AddChapterCommand}"
                    Content="   장 추가  "
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    Margin="0,0,6,6"
                    HorizontalContentAlignment="Center"
                    Command="{Binding RemoveChapterCommand}"
                    Content="  장 삭제  "
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    Margin="0,0,6,6"
                    Command="{Binding AddSceneCommand}"
                    Content="Scene 추가"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    Margin="0,0,0,6"
                    Command="{Binding RemoveSceneCommand}"
                    Content="Scene 삭제"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </WrapPanel>
            <TreeView x:Name="StructureTree" SelectedItemChanged="OnTreeSelectedItemChanged">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:ChapterNode}" ItemsSource="{Binding Scenes}">
                        <!--  Scene으로 분할된 장은 하이라이트 표시 (기본은 강조, Scene 0개면 해제)  -->
                        <Border
                            x:Name="ChapterRow"
                            Padding="4,1"
                            Background="#3329B6F6"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="ChapterIcon"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Kind="BookCheck" />
                                <Border
                                    Margin="0,0,5,0"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Background="#5529B6F6"
                                    CornerRadius="7"
                                    Visibility="{Binding Phase, Converter={StaticResource StringToVis}}">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Text="{Binding Phase}" />
                                </Border>
                                <TextBlock
                                    x:Name="ChapterTitle"
                                    FontWeight="Bold"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </Border>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Scenes.Count}" Value="0">
                                <Setter TargetName="ChapterRow" Property="Background" Value="Transparent" />
                                <Setter TargetName="ChapterIcon" Property="Kind" Value="BookOutline" />
                                <Setter TargetName="ChapterTitle" Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type models:SceneNode}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Kind="MovieOutline" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemsSource>
                    <Binding Path="Project.Chapters" />
                </TreeView.ItemsSource>
            </TreeView>
        </DockPanel>

        <!--  우: 상세 편집  -->
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="2"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <!--  선택 안 함 안내  -->
                <TextBlock
                    Margin="20"
                    VerticalAlignment="Top"
                    Opacity="0.6"
                    Text="왼쪽 트리에서 장 또는 Scene을 선택하면 여기서 편집할 수 있습니다."
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedChapter}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  장 편집  -->
                <StackPanel Visibility="{Binding HasSelectedChapter, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="장 편집" />
                    <Border
                        Margin="0,0,0,8"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                            Text="{Binding SelectedChapter.Phase, StringFormat=이야기 단계: {0}}" />
                    </Border>
                    <TextBox
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="제목"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Title}" />
                    <TextBox
                        MinHeight="60"
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="요약"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Summary}"
                        TextWrapping="Wrap" />
                    <TextBox
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="목적"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Purpose}" />
                    <TextBox
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="갈등"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Conflict}" />
                    <TextBox
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="반전"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Reveal}" />
                    <TextBox
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="종료 상태"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SelectedChapter.Ending}" />
                    <Button
                        Margin="0,4,0,16"
                        HorizontalAlignment="Left"
                        Command="{Binding GenerateScenesCommand}"
                        Content="이 장을 Scene으로 분할 (AI)"
                        Style="{StaticResource MaterialDesignRaisedButton}" />

                    <!--  Scene 편집  -->
                    <StackPanel Visibility="{Binding HasSelectedScene, Converter={StaticResource BoolToVis}}">
                        <Separator Margin="0,0,0,12" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Scene 편집" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="제목"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Title}" />
                        <TextBox
                            MinHeight="52"
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="요약"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Summary}"
                            TextWrapping="Wrap" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="목표"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Goal}" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="등장인물"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Characters}" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="장소"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Location}" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="갈등"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Conflict}" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="결과"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Result}" />
                        <TextBox
                            Margin="0,0,0,8"
                            materialDesign:HintAssist.Hint="다음 Scene 연결"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.NextLink}" />
                        <TextBlock Margin="0,6,0,2" Text="{Binding DialogueRatio, StringFormat=묘사 ◀▶ 대사   (대사 {0}% · 묘사 나머지)}" />
                        <Slider
                            Margin="0,0,0,8"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="5"
                            Value="{Binding DialogueRatio}" />

                        <!--  본문 수위(성인) 설정 — 무검열 모델일 때만 표시  -->
                        <Border Margin="0,0,0,8" Padding="10" Background="#33D84315" CornerRadius="6" Visibility="{Binding IsUncensoredModel, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#FFFF8A65" Text="🔞 본문 수위 (무검열 모델 전용)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="이용 등급" />
                                        <ComboBox ItemsSource="{Binding ContentRatingOptions}" SelectedItem="{Binding Project.ContentRating}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="선정성" />
                                        <ComboBox ItemsSource="{Binding SexualLevelOptions}" SelectedItem="{Binding Project.SexualLevel}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="폭력·잔혹" />
                                        <ComboBox ItemsSource="{Binding ViolenceLevelOptions}" SelectedItem="{Binding Project.ViolenceLevel}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.75" Text="18+ 선택 시 성인 수위로 작성됩니다. 관련 법규·개인 용도로만 사용하세요." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,4,0,8">
                            <Button
                                Margin="0,0,8,8"
                                Command="{Binding GenerateSceneContentCommand}"
                                Content="본문 작성 (AI)"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Margin="0,0,8,8"
                                Command="{Binding GenerateSceneContentDetailedCommand}"
                                Content="상세 작성 (길게)"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Margin="0,0,0,8"
                                Command="{Binding InsertSceneToEditorCommand}"
                                Content="에디터에 삽입"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        </WrapPanel>
                        <TextBox
                            MinHeight="200"
                            materialDesign:HintAssist.Hint="본문"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.Content}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  씬 삽화 (이미지 생성) — 등장인물 외형 자동 반영  -->
                        <Separator Margin="0,12,0,8" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="Bold"
                            Text="🖼 삽화 (이미지 생성)" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            Opacity="0.8"
                            Text="{Binding ImageServerStatus}" />
                        <TextBox
                            MinHeight="44"
                            Margin="0,0,0,6"
                            materialDesign:HintAssist.Hint="이미지 프롬프트(영어, 비우면 자동 생성)"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedScene.IllustrationPrompt}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding GenerateSceneImageCommand}"
                                Content="삽화 생성"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding InsertSceneImageCommand}"
                                Content="본문에 삽입"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="생성된 삽화를 원고 본문(커서 위치)에 삽입합니다." />
                            <Button
                                Command="{Binding SaveSceneImageAsFileCommand}"
                                Content="파일로 저장"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="생성된 삽화를 원하는 위치에 PNG로 저장합니다." />
                        </StackPanel>
                        <Image
                            MaxHeight="340"
                            Margin="0,4"
                            HorizontalAlignment="Left"
                            Source="{Binding SelectedScene.IllustrationPath, Converter={StaticResource PathToImage}}"
                            Stretch="Uniform" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  하단: 진행/일관성/저장  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,10,0,0"
            Padding="10"
            Background="#22808080"
            CornerRadius="6">
            <StackPanel>
                <!--  원고 역분석 (원고 → 설계): 별도 구역  -->

                <ProgressBar
                    Height="4"
                    Margin="0,0,0,8"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding OpenFromFileCommand}"
                            Content="열기"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding SaveToFileCommand}"
                            Content="파일로 저장"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding CheckConsistencyCommand}"
                            Content="스토리 일관성 검사"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="저장"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        Text="{Binding StatusMessage}" />
                </DockPanel>
                <TextBox
                    MaxHeight="120"
                    Margin="0,8,0,0"
                    materialDesign:HintAssist.Hint="일관성 검사 결과"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding ConsistencyResult}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <Border
                    Margin="0,0,0,8"
                    Padding="8"
                    Background="#332979FF"
                    CornerRadius="6">
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock FontWeight="Bold" Text="📖 원고에서 역분석 (원고 → 설계)" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.75"
                                Text="에디터의 소설을 AI로 분석해 설계를 자동 생성합니다." />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding AnalyzeSettingsCommand}"
                                Content="설정·인물"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding AnalyzeSynopsisCommand}"
                                Content="시놉시스"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding AnalyzeChaptersCommand}"
                                Content="장 구조"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Command="{Binding AnalyzeAllCommand}"
                                Content="전체 분석"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        </WrapPanel>
                    </DockPanel>
                </Border>

            </StackPanel>


        </Border>
    </Grid>
</Window>
