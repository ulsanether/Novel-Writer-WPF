<Window
    x:Class="NovelWriter.Wpf.ImageServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovelWriter.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="이미지 생성 서버 설정"
    Width="600"
    Height="760"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <DockPanel Margin="0">
        <!-- 하단 버튼 -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" Background="#22808080">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Click="OnSave" Content="저장" Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Width="90" Click="OnClose" Content="닫기" Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Margin="0,0,0,4" FontSize="18" FontWeight="Bold" Text="🖼️ 이미지 생성 서버 (ComfyUI)" />
                <TextBlock Margin="0,0,0,16" Opacity="0.7" Text="캐릭터·장면 삽화 생성용 서버입니다. 순서대로 설치 → 모델 다운로드 → 실행하세요." TextWrapping="Wrap" />

                <!-- 사양 + 연결/실행 -->
                <Border Margin="0,0,0,14" Padding="14" Background="#18808080" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="내 그래픽카드 사양 (VRAM)" />
                        <ComboBox Margin="0,0,0,2" DisplayMemberPath="DisplayName" ItemsSource="{Binding HardwareProfiles}" SelectedItem="{Binding SelectedHardware}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <TextBlock Margin="0,0,0,10" FontSize="11" Opacity="0.7" Text="{Binding SelectedHardware.Note}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding TestImageServerCommand}" Content="연결 확인" Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Margin="0,0,8,0" Command="{Binding LaunchImageServerCommand}" Content="서버 실행" Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding ImageServerStatus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 화풍(이미지 스타일) -->
                <Border Margin="0,0,0,14" Padding="14" Background="#18808080" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="🎨 화풍 (이미지 스타일)" />
                        <TextBlock Margin="0,0,0,4" FontSize="12" Text="화풍 프리셋" />
                        <ComboBox Margin="0,0,0,8" ItemsSource="{Binding StylePresetOptions}" SelectedItem="{Binding StylePreset}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Text="품질" />
                                <ComboBox ItemsSource="{Binding StyleQualityOptions}" SelectedItem="{Binding StyleQuality}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Text="조명" />
                                <ComboBox ItemsSource="{Binding StyleLightingOptions}" SelectedItem="{Binding StyleLighting}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Text="색감" />
                                <ComboBox ItemsSource="{Binding StyleColorMoodOptions}" SelectedItem="{Binding StyleColorMood}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>
                        </Grid>
                        <TextBox Margin="0,0,0,6" materialDesign:HintAssist.Hint="추가 프롬프트(＋, 영어)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding StyleExtraPositive, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,0,0,8" materialDesign:HintAssist.Hint="제외 프롬프트(－, 영어)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding StyleExtraNegative, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.8" Text="{Binding StyleResolutionPreview, StringFormat=추천 해상도/스텝: {0}}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.65" Text="{Binding StylePositivePreview, StringFormat=긍정: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.65" Text="{Binding StyleNegativePreview, StringFormat=부정: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ComfyUI 그룹 -->
                <Border Margin="0,0,0,14" Padding="14" Background="#18808080" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="ComfyUI — 최신 모델 (SDXL·FLUX)" />
                        <TextBox Margin="0,0,0,8" materialDesign:HintAssist.Hint="서버 주소 (예: http://127.0.0.1:8188)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ComfyUiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,8" Opacity="0.7" Text="포터블 빌드라 Python 설치가 필요 없습니다. [자동 설치]는 7-Zip(없으면 자동 설치) + 약 1.5~2GB를 내려받습니다. 설치 후 모델(.safetensors)을 모델 폴더에 넣어야 합니다." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding InstallComfyUiCommand}" Content="ComfyUI 자동 설치" IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Margin="0,0,8,0" Command="{Binding LaunchImageServerCommand}" Content="ComfyUI 실행" Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Command="{Binding OpenComfyModelsFolderCommand}" Content="모델 폴더 열기" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <TextBox Margin="0,8,0,0" materialDesign:HintAssist.Hint="설치 경로" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ComfyUiPath}" />

                        <Separator Margin="0,12,0,10" Opacity="0.3" />
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="모델(체크포인트) 자동 다운로드" />
                        <ComboBox Margin="0,0,0,4" DisplayMemberPath="DisplayName" ItemsSource="{Binding ComfyModels}" SelectedItem="{Binding SelectedComfyModel}" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <TextBlock Margin="0,0,0,4" FontSize="11" Opacity="0.7" Text="{Binding SelectedComfyModel.Note}" TextWrapping="Wrap" />
                        <Border Margin="0,0,0,8" Padding="8,4" Background="#33D84315" CornerRadius="4" Visibility="{Binding SelectedComfyModel.Uncensored, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" Foreground="#FFFF8A65" Text="🔞 무검열 모델입니다. 로컬 생성이라 필터가 없으니, 관련 법규와 각 모델 라이선스를 지켜 성인 본인만 개인 용도로 사용하세요." TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,0" HorizontalAlignment="Left" Command="{Binding DownloadComfyModelCommand}" Content="선택 모델 다운로드" IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button HorizontalAlignment="Left" Command="{Binding EnsureComfyModelCommand}" Content="모델 자동 준비" IsEnabled="{Binding IsImageSetupBusy, Converter={StaticResource InverseBool}}" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="설치된 모델이 없으면 선택 모델을 자동으로 내려받아 연결합니다." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20" Margin="0,0,8,0" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" Visibility="{Binding IsImageSetupBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Command="{Binding OpenImageServerPageCommand}" Content="설치 안내 열기" Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>

                <!-- 로그 -->
                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="진행 로그" />
                <Border Padding="8" Background="#22000000" CornerRadius="4">
                    <TextBox Height="150" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" Text="{Binding ImageSetupLog}" TextWrapping="NoWrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
